{
  "name": "codeguard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CodeGuard API Server",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "dev:worker": "node --watch src/workers/index.js",
    "start": "node src/app.js",
    "start:worker": "node src/workers/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node src/scripts/seed.js",
    "benchmark": "node src/scripts/benchmark.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
